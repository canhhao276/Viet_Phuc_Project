# ==============================================================================
# BẢN MẪU CẤU HÌNH API - DỰ ÁN VIỆT PHỤC REMIX
# Hướng dẫn: Đổi tên file này thành ".env" và điền các API Key của bạn vào dưới đây
# ==============================================================================

# 1. Google Gemini API Key (Bắt buộc để AI viết prompt mượt mà)
# Đăng ký miễn phí tại: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# 2. HuggingFace API Key (Tùy chọn - Dùng để sinh ảnh bằng FLUX.1/SDXL xịn xò)
# Đăng ký miễn phí tại: https://huggingface.co/settings/tokens (Nhớ cấp quyền "Write")
# Lưu ý: Nếu bỏ trống, hệ thống sẽ tự động chuyển sang dùng Pollinations (miễn phí)
VITE_HF_API_KEY=your_huggingface_api_key_here
