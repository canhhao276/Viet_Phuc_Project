# ==============================================================================
# BẢN MẪU CẤU HÌNH API - DỰ ÁN VIỆT PHỤC REMIX
# Hướng dẫn: Đổi tên file này thành ".env" và điền các API Key của bạn vào dưới đây
# ==============================================================================

# 1. Google Gemini API Key (Khuyên dùng để phân tích văn hóa và phối đồ chuẩn triều đại)
# Đăng ký miễn phí tại: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# 2. Hugging Face Access Token (Tùy chọn - để trống vẫn dùng được 100% MIỄN PHÍ)
# Dùng để tăng tốc hàng đợi khi gọi FLUX.1-schnell ZeroGPU trên Hugging Face Spaces
# Lấy token miễn phí tại: https://huggingface.co/settings/tokens (Type: Read)
VITE_HF_TOKEN=

# 3. Segmind API Key (Tùy chọn / Fallback dự phòng)
# Đăng ký tại: https://www.segmind.com/
VITE_SEGMIND_API_KEY=your_segmind_api_key_here
